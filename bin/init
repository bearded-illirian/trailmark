#!/bin/bash
# init — interactive Q&A wizard that populates `framework.yml` from
# `framework.yml.example` on end-user's first run.
#
# v0.2.0 (Block 24): simplified for workspace layout. Only 3 real prompts —
# aihub_root, server_primary (optional), server_telegram_relay (optional).
# All derived paths (tasks_root, routing_db, log_dir_base) are computed by
# scripts at runtime from workspace root ($SCRIPT_DIR/..).
#
# Also seeds aihub/projects.yml from the example if it doesn't exist yet.
#
# Reads:  framework.yml.example (schema + defaults)
# Writes: framework.yml (per-user config, gitignored)
#         aihub/projects.yml (project registry, if missing)
#
# Portable: works with macOS bash 3.2 (no `read -e -i`).

set -e

# ── Paths (relative to script location) ──────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
EXAMPLE="$WORKSPACE_ROOT/framework.yml.example"
TARGET="$WORKSPACE_ROOT/framework.yml"
PROJECTS_YML="$WORKSPACE_ROOT/aihub/projects.yml"

# ── Sanity checks ────────────────────────────────────────────────────────
[ -f "$EXAMPLE" ] || { echo "❌ Schema reference missing: $EXAMPLE"; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "❌ python3 not found — required for YAML parsing"; exit 1; }

echo "════════════════════════════════════════════"
echo "  framework init — set up your framework.yml"
echo "════════════════════════════════════════════"
echo ""
echo "Workspace root: $WORKSPACE_ROOT"
echo ""

# ── Overwrite guard ──────────────────────────────────────────────────────
if [ -f "$TARGET" ]; then
  echo "⚠️  $TARGET already exists."
  printf "Overwrite? [y/N]: "
  read -r OVERWRITE
  case "$OVERWRITE" in
    y|Y|yes|YES) echo "Continuing — existing values will be replaced.";;
    *) echo "Aborted. Existing framework.yml preserved."; exit 0;;
  esac
  echo ""
fi

# ── 3 real prompts ───────────────────────────────────────────────────────
echo "Enter values or press Enter to accept the shown default."
echo ""

# 1. aihub_root
echo "── aihub location ──"
echo "  Where does your aihub-style skill master live?"
echo "  Default: ./aihub (inside this workspace, works out-of-the-box)"
printf "  aihub_root [./aihub]: "
read -r AIHUB_ROOT
[ -z "$AIHUB_ROOT" ] && AIHUB_ROOT="./aihub"
echo ""

# 2. server_primary (optional)
echo "── deploy server (optional) ──"
echo "  Primary application server for git-push auto-deploy."
echo "  Example: root@203.0.113.10"
echo "  Leave empty to skip (no remote deploy)."
printf "  server_primary []: "
read -r SERVER_PRIMARY
echo ""

# 3. server_telegram_relay (optional)
echo "── telegram relay (optional) ──"
echo "  Relay server for TG bots (if Telegram API blocked in your region)."
echo "  Example: root@198.51.100.20"
echo "  Leave empty to skip."
printf "  server_telegram_relay []: "
read -r SERVER_TG_RELAY
echo ""

# 4. default_agent
echo "── default agent ──"
echo "  Which runtime new projects are wired for by default."
echo "  claude — the only runtime the framework has been run on."
echo "  codex  — experimental adapter, see adapters/codex/README.md."
printf "  default_agent [claude]: "
read -r DEFAULT_AGENT
[ -z "$DEFAULT_AGENT" ] && DEFAULT_AGENT="claude"
case "$DEFAULT_AGENT" in
  claude|codex) ;;
  *) echo "  Unknown agent '$DEFAULT_AGENT' — falling back to claude."; DEFAULT_AGENT="claude";;
esac
echo ""

# ── Summary ──────────────────────────────────────────────────────────────
echo "── Summary ──"
echo "  paths.aihub_root         = $AIHUB_ROOT"
echo "  env.server_primary       = ${SERVER_PRIMARY:-null}"
echo "  env.server_telegram_relay = ${SERVER_TG_RELAY:-null}"
echo "  defaults.agent           = $DEFAULT_AGENT"
echo ""

printf "Write to %s? [Y/n]: " "$TARGET"
read -r CONFIRM
case "$CONFIRM" in
  n|N|no|NO) echo "Aborted. No file written."; exit 0;;
esac

# ── Compose and dump framework.yml ───────────────────────────────────────
AIHUB_ROOT_ENV="$AIHUB_ROOT" SERVER_PRIMARY_ENV="$SERVER_PRIMARY" \
SERVER_TG_RELAY_ENV="$SERVER_TG_RELAY" EXAMPLE_ENV="$EXAMPLE" \
DEFAULT_AGENT_ENV="$DEFAULT_AGENT" \
TARGET_ENV="$TARGET" python3 <<'PYEOF'
import yaml, os

example = yaml.safe_load(open(os.environ["EXAMPLE_ENV"]))
result = {
    "meta": example.get("meta", {}),
    "paths": {"aihub_root": os.environ["AIHUB_ROOT_ENV"]},
    "env": {
        "server_primary": os.environ["SERVER_PRIMARY_ENV"] or None,
        "server_telegram_relay": os.environ["SERVER_TG_RELAY_ENV"] or None,
    },
    "defaults": {"agent": os.environ["DEFAULT_AGENT_ENV"]},
}
with open(os.environ["TARGET_ENV"], "w") as f:
    yaml.safe_dump(result, f, sort_keys=False, default_flow_style=False)
PYEOF

echo ""
echo "✅ Wrote $TARGET"

# ── Seed aihub/projects.yml if missing ───────────────────────────────────
if [ ! -f "$PROJECTS_YML" ]; then
  mkdir -p "$(dirname "$PROJECTS_YML")"
  cat > "$PROJECTS_YML" <<'YAMLEOF'
# projects.yml — registry of consumer projects sharing this aihub's skill library.
# Edit this file directly, or use `bin/new-project my-app` to add entries.

meta:
  schema_version: 0.1.0

projects: []
YAMLEOF
  echo "✅ Seeded $PROJECTS_YML"
fi

echo ""
echo "Next steps:"
echo "  1. Add your first project:  bash bin/new-project my-first-app"
echo "  2. Sync framework skills:   bash bin/sync-from-aihub.sh"
echo "  3. Optional demo tour:      bash bin/init-sample     # seeds a populated sample project"
echo "  4. Browse tasks + files:    bash bin/flow-ui/serve   # then open http://127.0.0.1:8765/"
