# framework.yml — per-user config for the framework
#
# This is the canonical schema reference. Copy it to `framework.yml` (which is
# git-ignored) and fill in your local values. `bin/init` will do this
# interactively for you.
#
# Consumed by:
#   - bin/init                 — writes framework.yml from Q&A wizard
#   - bin/sync-from-aihub.sh   — sync-time inject: substitutes {{ config.paths.X }}
#                                tokens in synced skill files
#   - (indirectly) skill files — the tokens are the target of substitution;
#                                 skills carry {{ config.paths.X }} literals in
#                                 aihub source
#
# Editing policy:
#   - Bump `meta.schema_version` on breaking shape changes (semver)
#   - Never commit `framework.yml` (it holds your local paths and hosts)
#   - `framework.yml.example` is the committed reference — keep in sync with
#     what bin/init writes
#

meta:
  # Bump on breaking shape changes. Consumers gate against known versions.
  schema_version: 0.2.0

# ── Paths ──────────────────────────────────────────────────────────────────
# In workspace mode (post-v0.4.0 layout), only `aihub_root` is prompted.
# Everything else is DERIVED from workspace root (script location) — see
# "Derived paths" comment below.
paths:

  # Where your aihub-style skill master lives.
  # Default: `./aihub` inside the workspace (works out-of-the-box for MVP).
  # Override with an absolute path if aihub lives outside this workspace.
  aihub_root: ./aihub

  # ── Derived paths (auto-computed by scripts) ────────────────────────────
  # The following values are NOT prompted by bin/init — scripts compute them
  # from the workspace root (bin/*.sh scripts detect it via $SCRIPT_DIR/..).
  # Listed here for documentation only; not written to framework.yml.
  #
  # workspace_root      = $SCRIPT_DIR/..  (workspace containing aihub/, projects/, tasks/)
  # tasks_root          = $workspace_root/tasks
  # routing_db          = $workspace_root/tasks/routing.db
  # log_dir_base        = $workspace_root/tasks/log
  # projects_yml        = $workspace_root/aihub/projects.yml

# ── Environment ────────────────────────────────────────────────────────────
# Optional. Only needed if you want git-push auto-deploy (see
# docs/AUTO_DEPLOY_RECIPE.md) or SSH-driven skills.
env:

  # Primary application server — where products get deployed via `git push`.
  # Example: root@203.0.113.10 or root@myserver.example
  # Leave as null if you don't use remote deploy.
  server_primary: null

  # Telegram-relay server (optional). Bots and long-lived polling live here
  # because Telegram API is blocked from some regions.
  # Example: root@198.51.100.20
  # Leave as null if you don't run a relay.
  server_telegram_relay: null

# ── Projects ──────────────────────────────────────────────────────────────
# Registry of your projects lives in `aihub/projects.yml` (workspace-relative
# path). bin/new-project appends entries there; bin/init seeds it on first
# run if missing.
#
# See `docs/PROJECTS_GUIDE.md` for the hub-and-spoke pattern that ties this
# registry to the projects/ folder + skill symlinks.
